# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (it's in .gitignore).

# --- Database -----------------------------------------------------------
SENTRYX_DB_HOST=localhost
SENTRYX_DB_PORT=5432
SENTRYX_DB_NAME=sentryx
SENTRYX_DB_USER=sentryx
SENTRYX_DB_PASSWORD=change-me-to-a-strong-password

# --- Anthropic API --------------------------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRYX_MODEL=claude-sonnet-4-6

# --- Optional ---------------------------------------------------------
# Raises your NVD CVE lookup rate limit from 5 to 50 req/30s.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Tool behavior --------------------------------------------------------
SENTRYX_TOOL_TIMEOUT=120
SENTRYX_MAX_AGENTIC_TURNS=6
SENTRYX_LOG_LEVEL=INFO
